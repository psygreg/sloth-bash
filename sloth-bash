source ~/.alias-list
# bash file manager
shopt -s autocd
function cd {
  local arg="$1"
  case "$arg" in
    ...)    arg="../..";;
    ....)   arg="../../..";;
    .....)  arg="../../../..";;
  esac
  builtin cd "$arg" "${@:2}" && ls -F
}
# detach app wrapper
detach() {
  local cmd="$1"
  local resolved="$cmd"
  if [[ -n "${FLATPAK_ALIASES[$cmd]}" ]]; then
    if flatpak info "${FLATPAK_ALIASES[$cmd]}" > /dev/null 2>&1; then
      resolved="flatpak run ${FLATPAK_ALIASES[$cmd]}"
    fi
  else
    local match
    match=$(flatpak list --app --columns=application 2>/dev/null \
      | grep -v -i "Platform" \
      | grep -iE "(^|\.)${cmd}(\.|$)" \
      | head -n 1)
    if [[ -n "$match" ]]; then
      resolved="flatpak run $match"
    fi
  fi
  nohup $resolved "${@:2}" > /dev/null 2>&1 &
}
# python3 wrapper and flatpak matcher
command_not_found_handle() {
  local cmd_lower="${1,,}"
  local match=$(compgen -c 2>/dev/null | grep -i "^${cmd_lower}$" | head -n 1)
  if [[ -n "$match" ]]; then
    "$match" "${@:2}"
    return $?
  fi
  local cmd="$1"
  if [[ "$1" == *.py ]]; then
    local script_dir
    script_dir=$(dirname "$1")
    if [[ -d "$script_dir/venv" ]]; then
      source "$script_dir/venv/bin/activate"
    elif [[ -d "$script_dir/.venv" ]]; then
      source "$script_dir/.venv/bin/activate"
    fi
    python3 "$@"
    return $?
  fi
  if [[ -f "$1" ]]; then
    if [[ -x "$1" ]]; then
      ./"$1" "${@:2}"
      return $?
    else
      xdg-open "$1"
      return $?
    fi
  fi
  shift
  local args=("$@")
  if [[ -n "${FLATPAK_ALIASES[$cmd]}" ]]; then
    if flatpak info "${FLATPAK_ALIASES[$cmd]}" > /dev/null 2>&1; then
      flatpak run "${FLATPAK_ALIASES[$cmd]}" "${args[@]}"
      return $?
    fi
  fi
  local match
    match=$(flatpak list --app --columns=application 2>/dev/null \
      | grep -v -i "Platform" \
      | grep -iE "(^|\.)${cmd}(\.|$)" \
      | head -n 1)
  if [[ -n "$match" ]]; then
    flatpak run "$match" "${args[@]}"
    return $?
  fi
  echo "bash: $cmd: command not found" >&2
  return 127
}
# cp and mv replacers
cp() {
  if [ "$#" -lt 2 ]; then
    command cp "$@"
    return $?
  fi
  command rsync -ah --info=progress2 "$@"
}
mv() {
  if [ "$#" -lt 2 ]; then
    command mv "$@"
    return $?
  fi
  local dest="${@: -1}"
  if [[ "$dest" != */* ]]; then
    command mv "$@"
    return $?
  fi
  command rsync -ah --info=progress2 --remove-source-files "$@"
}
# zsh features
mkcd() {
  if [ "$#" -lt 1 ]; then
    command mkdir "$@"
    return $?
  fi
  mkdir -p "$1" && cd "$1"
}
take() {
  if [ "$#" -lt 1 ]; then
    echo "take: missing argument" >&2
    return 1
  fi
  local arg="$1"
  if [[ "$arg" =~ ^https?:// ]]; then
    if [[ "$arg" == *.git ]]; then
      git clone "$arg" || return $?
      local dir=$(basename "$arg" .git)
      cd "$dir"
    elif [[ "$arg" == *.tar.gz ]] || [[ "$arg" == *.tar.bz2 ]] || [[ "$arg" == *.tar ]] || [[ "$arg" == *.zip ]] || [[ "$arg" == *.rar ]]; then
      local filename=$(basename "$arg")
      wget "$arg" -O "$filename" || return $?
      local base_dir 
      if [[ "$filename" == *.tar.gz ]]; then
        base_dir="${filename%.tar.gz}"
        mkdir -p "$base_dir"
        tar -xzf "$filename" -C "$base_dir" || return $?
      elif [[ "$filename" == *.tar.bz2 ]]; then
        base_dir="${filename%.tar.bz2}"
        mkdir -p "$base_dir"
        tar -xjf "$filename" -C "$base_dir" || return $?
      elif [[ "$filename" == *.tar ]]; then
        base_dir="${filename%.tar}"
        mkdir -p "$base_dir"
        tar -xf "$filename" -C "$base_dir" || return $?
      elif [[ "$filename" == *.zip ]]; then
        base_dir="${filename%.zip}"
        mkdir -p "$base_dir"
        unzip "$filename" -d "$base_dir" || return $?
      elif [[ "$filename" == *.rar ]]; then
        base_dir="${filename%.rar}"
        mkdir -p "$base_dir"
        cd "$base_dir"
        unrar x "../$filename" || return $?
        cd ..
      fi
      rm "$filename"
      cd "$base_dir"
    else
      echo "take: unsupported URL type" >&2
      return 1
    fi
  else
    mkcd "$arg"
  fi
}
# rolling tab
bind 'set show-all-if-ambiguous on'
bind 'TAB:menu-complete'
# starship
if which starship &> /dev/null; then
  eval "$(starship init bash)"
fi
# zellij
if which zellij &> /dev/null; then
  eval "$(zellij setup --generate-auto-start bash)"
fi