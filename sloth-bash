[[ -f ~/.alias-list ]] && source ~/.alias-list

# bash file manager
shopt -s autocd
function cd {
  if [[ $# -eq 0 ]]; then
    builtin cd && ls -F
    return $?
  fi

  local arg="$1"
  case "$arg" in
    ...)    arg="../..";;
    ....)   arg="../../..";;
    .....)  arg="../../../..";;
  esac
  builtin cd "$arg" "${@:2}" && ls -F
}
# detach app wrapper
detach() {
  local cmd="$1"
  local resolved="$cmd"
  if [[ -f "$cmd" && -x "$cmd" ]]; then
    resolved="./$cmd"
  else
    if command -v distrobox &>/dev/null; then
      local distroBoxes=$(distrobox list 2>/dev/null | awk 'NR>1 {print $3}')
      if echo "$distroBoxes" | grep -q "^${cmd}$"; then
        nohup distrobox enter "$cmd" -- "${@:2}" > /dev/null 2>&1 &
        return $?
      fi
    fi
    if [[ -n "${FLATPAK_ALIASES[$cmd]}" ]]; then
      if flatpak info "${FLATPAK_ALIASES[$cmd]}" > /dev/null 2>&1; then
        resolved="flatpak run ${FLATPAK_ALIASES[$cmd]}"
      fi
    else
      if [[ "${cmd,,}" != "kde" && "${cmd,,}" != "gnome" ]]; then
        local match
        match=$(flatpak list --app --columns=application 2>/dev/null \
          | grep -v -i "Platform" \
          | grep -iE "(^|\.)${cmd}(\.|$)" \
          | head -n 1)
        if [[ -n "$match" ]]; then
          resolved="flatpak run $match"
        fi
      fi
    fi
  fi
  nohup $resolved "${@:2}" > /dev/null 2>&1 &
}

_sloth_run_quick_lookup() {
  if command -v timeout >/dev/null 2>&1; then
    timeout 0.5s "$@" 2>/dev/null
  else
    "$@" 2>/dev/null
  fi
}

# python3 wrapper and flatpak matcher
command_not_found_handle() {
  local cmd_lower="${1,,}"
  local match=$(compgen -c 2>/dev/null | grep -i "^${cmd_lower}$" | head -n 1)
  if [[ -n "$match" ]]; then
    "$match" "${@:2}"
    return $?
  fi
  local cmd="$1"
  if [[ "$1" == *.py ]]; then
    local script_dir
    script_dir=$(dirname "$1")
    if [[ -d "$script_dir/venv" ]]; then
      source "$script_dir/venv/bin/activate"
    elif [[ -d "$script_dir/.venv" ]]; then
      source "$script_dir/.venv/bin/activate"
    fi
    python3 "$@"
    return $?
  fi
  if [[ -f "$1" ]]; then
    if [[ -x "$1" ]]; then
      ./"$1" "${@:2}"
      return $?
    else
      xdg-open "$1"
      return $?
    fi
  fi
  shift
  local args=("$@")
  if command -v flatpak >/dev/null 2>&1 && [[ -n "${FLATPAK_ALIASES[$cmd]}" ]]; then
    if flatpak info "${FLATPAK_ALIASES[$cmd]}" > /dev/null 2>&1; then
      flatpak run "${FLATPAK_ALIASES[$cmd]}" "${args[@]}"
      return $?
    fi
  fi
  if command -v flatpak >/dev/null 2>&1 && [[ "${cmd,,}" != "kde" && "${cmd,,}" != "gnome" ]]; then
    local match
      match=$(_sloth_run_quick_lookup flatpak list --app --columns=application \
        | grep -v -i "Platform" \
        | grep -iF -m 1 "$cmd")
    if [[ -n "$match" ]]; then
      match=$(printf '%s\n' "$match" | head -n 1)
    fi
    if [[ -z "$match" ]]; then
      match=$(_sloth_run_quick_lookup flatpak list --app --columns=application \
        | grep -v -i "Platform" \
        | grep -iE "(^|\.)${cmd}(\.|$)" \
        | head -n 1)
    fi
    if [[ -n "$match" ]]; then
      flatpak run "$match" "${args[@]}"
      return $?
    fi
  fi
  if command -v distrobox &>/dev/null; then
    local distroBoxes
    distroBoxes=$(_sloth_run_quick_lookup distrobox list | awk 'NR>1 {print $3}')
    if printf '%s\n' "$distroBoxes" | grep -Fxq "$cmd"; then
      if [[ -n "${args[0]}" ]]; then
        distrobox enter "$cmd" -- "${args[@]}"
      else
        distrobox enter "$cmd"
      fi
      return $?
    fi
  fi
  echo "bash: $cmd: command not found" >&2
  return 127
}
# 'all' keyword expansion
_expand_all_keyword() {
  local -a out=()
  local arg dir entries
  for arg in "$@"; do
    if [[ "$arg" == "all" ]]; then
      entries=( "$PWD"/* )
      if [[ "${#entries[@]}" -eq 1 && ! -e "${entries[0]}" ]]; then
        echo "_expand_all_keyword: no entries in $PWD" >&2
        return 1
      fi
      out+=( "${entries[@]}" )
    elif [[ "$arg" == */all ]]; then
      dir="${arg%/all}"
      if [[ ! -d "$dir" ]]; then
        echo "_expand_all_keyword: not a directory: $dir" >&2
        return 1
      fi
      entries=( "$dir"/* )
      if [[ "${#entries[@]}" -eq 1 && ! -e "${entries[0]}" ]]; then
        echo "_expand_all_keyword: no entries in $dir" >&2
        return 1
      fi
      out+=( "${entries[@]}" )
    else
      out+=( "$arg" )
    fi
  done
  printf '%s\0' "${out[@]}"
}
_run_with_all() {
  local cmd="$1"; shift
  local -a expanded=()
  while IFS= read -r -d '' item; do
    expanded+=( "$item" )
  done < <(_expand_all_keyword "$@") || return $?
  if [[ "$cmd" == "rm" ]]; then
    local -a opts=() paths=()
    for item in "${expanded[@]}"; do
      if [[ "$item" == -* ]]; then
        opts+=( "$item" )
      else
        paths+=( "$item" )
      fi
    done
    command rm -i "${opts[@]}" "${paths[@]}"
  elif [[ "$cmd" == "rd" ]]; then
    local -a dirs_only=()
    for item in "${expanded[@]}"; do
      [[ -d "$item" && ! -L "$item" ]] && dirs_only+=( "$item" )
    done
    command rm -r "${dirs_only[@]}"
  else
    command "$cmd" "${expanded[@]}"
  fi
}

_sloth_has_option_arg() {
  local arg
  for arg in "$@"; do
    if [[ "$arg" == -- ]]; then
      return 1
    fi
    if [[ "$arg" == -* ]]; then
      return 0
    fi
  done
  return 1
}

_sloth_total_size_bytes() {
  local total
  total=$(du -sb "$@" 2>/dev/null | awk 'END {print $1}')
  if [[ "$total" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$total"
    return 0
  fi

  total=$(du -sk "$@" 2>/dev/null | awk '{sum += $1} END {print sum * 1024}')
  if [[ "$total" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$total"
    return 0
  fi

  return 1
}

_sloth_fzf_history_search() {
  command -v fzf >/dev/null 2>&1 || return 1

  local selected
  selected=$(fc -lnr 1 | awk 'NF && !seen[$0]++' | fzf --height 40% --layout=reverse --border --prompt='history> ' --query "$READLINE_LINE") || return 0

  READLINE_LINE="$selected"
  READLINE_POINT=${#READLINE_LINE}
}

_sloth_enable_basic_colors() {
  if command -v dircolors >/dev/null 2>&1; then
    if [[ -r ~/.dircolors ]]; then
      eval "$(dircolors -b ~/.dircolors)"
    else
      eval "$(dircolors -b)"
    fi
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'
    alias grep='grep --color=auto'
    LS_COLORS+=':ow=01;33'
  fi

  alias ll='ls -l'
  alias la='ls -A'
  alias l='ls -CF'
}

# cp and mv replacers
cp() {
  for a in "$@"; do
    if [[ "$a" == "all" || "$a" == */all ]]; then
      _run_with_all cp "$@"; return $?
    fi
  done
  if [ "$#" -lt 2 ]; then
    command cp "$@"
    return $?
  fi
  if _sloth_has_option_arg "$@"; then
    command cp "$@"
    return $?
  fi
  local sources=("${@:1:$#-1}")
  local total_size
  total_size=$(_sloth_total_size_bytes "${sources[@]}") || {
    command cp "$@"
    return $?
  }
  local threshold=$((100 * 1024 * 1024))
  if (( total_size > threshold )); then
    command rsync -ah --no-owner --no-group --info=progress2 "$@"
  else
    command rsync -ah --no-owner --no-group "$@"
  fi
}
mv() {
  for a in "$@"; do
    if [[ "$a" == "all" || "$a" == */all ]]; then
      _run_with_all mv "$@"; return $?
    fi
  done
  if [ "$#" -lt 2 ]; then
    command mv "$@"
    return $?
  fi
  if _sloth_has_option_arg "$@"; then
    command mv "$@"
    return $?
  fi
  local dest="${@: -1}"
  local sources=("${@:1:$#-1}")
  local source_dir=$(dirname "${sources[0]}")
  local dest_dir=$(dirname "$dest")
  if [[ "$source_dir" == "$dest_dir" ]]; then
    command mv "$@"
    return $?
  fi
  local total_size
  total_size=$(_sloth_total_size_bytes "${sources[@]}") || {
    command mv "$@"
    return $?
  }
  local threshold=$((100 * 1024 * 1024))
  if (( total_size > threshold )); then
    command rsync -ah --no-owner --no-group --info=progress2 --remove-source-files "$@"
  else
    command rsync -ah --no-owner --no-group --remove-source-files "$@"
  fi
}
rm() {
  for a in "$@"; do
    if [[ "$a" == "all" || "$a" == */all ]]; then
      _run_with_all rm "$@"; return $?
    fi
  done
  command rm "$@"
}
rd() {
  for a in "$@"; do
    if [[ "$a" == "all" || "$a" == */all ]]; then
      _run_with_all rd "$@"; return $?
    fi
    if [ -d "$a" ]; then
      command rm -r "$a"
    else
      echo "rd: not a directory: $a" >&2
    fi
  done
}
# zsh features
mkcd() {
  if [ "$#" -lt 1 ]; then
    command mkdir "$@"
    return $?
  fi
  mkdir -p "$1" && cd "$1"
}
take() {
  if [ "$#" -lt 1 ]; then
    echo "take: missing argument" >&2
    return 1
  fi
  local arg="$1"
  if [[ "$arg" =~ ^https?:// ]]; then
    if [[ "$arg" == *.git ]]; then
      git clone "$arg" || return $?
      local dir=$(basename "$arg" .git)
      cd "$dir"
    elif [[ "$arg" == *.tar.gz ]] || [[ "$arg" == *.tar.bz2 ]] || [[ "$arg" == *.tar ]] || [[ "$arg" == *.zip ]] || [[ "$arg" == *.rar ]]; then
      local filename=$(basename "$arg")
      wget "$arg" -O "$filename" || return $?
      local base_dir
      if [[ "$filename" == *.tar.gz ]]; then
        base_dir="${filename%.tar.gz}"
        mkdir -p "$base_dir"
        tar -xzf "$filename" -C "$base_dir" || return $?
      elif [[ "$filename" == *.tar.bz2 ]]; then
        base_dir="${filename%.tar.bz2}"
        mkdir -p "$base_dir"
        tar -xjf "$filename" -C "$base_dir" || return $?
      elif [[ "$filename" == *.tar ]]; then
        base_dir="${filename%.tar}"
        mkdir -p "$base_dir"
        tar -xf "$filename" -C "$base_dir" || return $?
      elif [[ "$filename" == *.zip ]]; then
        base_dir="${filename%.zip}"
        mkdir -p "$base_dir"
        unzip "$filename" -d "$base_dir" || return $?
      elif [[ "$filename" == *.rar ]]; then
        base_dir="${filename%.rar}"
        mkdir -p "$base_dir"
        cd "$base_dir"
        unrar x "../$filename" || return $?
        cd ..
      fi
      rm "$filename"
      cd "$base_dir"
    else
      echo "take: unsupported URL type" >&2
      return 1
    fi
  else
    mkcd "$arg"
  fi
}
# interactive shell extras
if [[ $- == *i* ]]; then
  _sloth_enable_basic_colors
  # rolling tab
  bind 'set show-all-if-ambiguous on'
  bind 'TAB:menu-complete'
  if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --bash)"
  fi
  # starship
  if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
  fi
  # zellij
  if command -v zellij >/dev/null 2>&1; then
    eval "$(zellij setup --generate-auto-start bash)"
  fi
fi
